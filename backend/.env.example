# GitHub token for repository API rate limits.
GITHUB_TOKEN=

# Token with Actions: write permission on ChaitanyaBhusari01/GIT-CITY.
# GITHUB_TOKEN can be reused if it already has that permission.
GITHUB_ACTIONS_TOKEN=

OPENROUTER_API_KEY=

# Python FastAPI security service. Set the same token in ragservice/.env.
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_TOKEN=replace-with-a-long-random-secret

# For testing this feature branch, select its workflow file.
# After merging the workflow into the default branch, change this to main.
CODEQL_WORKFLOW_REF=feature/security-scan-integration

# Optional override for the repository that owns the CodeQL workflow.
GITCITY_REPOSITORY=ChaitanyaBhusari01/GIT-CITY
