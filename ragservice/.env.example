# Shared token used by Express to authenticate to FastAPI. Use a local process environment or private config.
# Never commit the real token; the current repository tracks a zero-byte ragservice/.env file.
RAG_SERVICE_TOKEN=replace-with-the-same-long-random-secret

# Add existing RAG configuration here when enabling indexing and LLM analysis:
# RAG_DATABASE_URL=
# OPENROUTER_API_KEY=
