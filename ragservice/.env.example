# Shared token used by Express to authenticate to FastAPI.
# Use the same private value in backend/.env and ragservice/.env. Never commit the real value.
RAG_SERVICE_TOKEN=replace-with-the-same-long-random-secret

# OpenRouter powers embeddings and evidence-grounded finding explanations.
# AI analysis is skipped (but SARIF findings still return) when this key is absent.
OPENROUTER_API_KEY=

# Neon PostgreSQL connection string. One of these names may be used.
# Required for durable code-chunk storage and pgvector similarity retrieval.
RAG_DATABASE_URL=
# NEON_DATABASE_URL=
# DATABASE_URL=

# Keep embedding model and pgvector column dimensions aligned.
GITCITY_EMBEDDING_MODEL=openai/text-embedding-3-small
GITCITY_EMBEDDING_DIMENSIONS=1536
GITCITY_LLM_MODEL=anthropic/claude-3-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cost / throughput guardrails for each scan. At most this many findings get AI triage.
SECURITY_AI_MAX_FINDINGS=20
SECURITY_ANALYSIS_WORKERS=3

# Maximum code chunks embedded per repository commit (default 10000, hard max 50000).
# If reached, source index metadata reports how many chunks were skipped.
GITCITY_MAX_INDEXED_CHUNKS=10000
